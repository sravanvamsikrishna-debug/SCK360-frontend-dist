# Apache static hosting fallback for known SCK360 React routes only.
# Place this file beside index.html in the deployed dist/ directory.
RewriteEngine On
RewriteRule ^(?:sck360/login|sck360/userTasks|sck360/tasks|sck360/calendar|sck360/profile|sck360/userKpiDashboard|sck360/settings|sck360/userTimeSheet|sck360/myTimeSheet|sck360/userPermissions|sck360/usersPage|sck360/home|sck360/techTeamDashboard|sck360/userKpiActivityDashboard|sck360/dailyActivityDashboard|sck360/dailyActivityPage|sck360/dailyActivityPermission|sck360/workingCalendarPage|sck360/gantDashboard|sck360/gantApprovals|sck360/gantMeetings|sck360/gantTracker|sck360/gantSettings|sck360/cafm45List|sck360/cafm45Detail|sck360/cafm45Page|sck360/accessDenied|sck360/downloadApp|sck360/kpiDashboard|sck360/projects|sck360/clientsDashboard|sck360/salesDMR/chasingPage|sck360/salesDMR/prospectivePage|sck360/salesDMR/mastersPage|sck360/salesDMR/importPage|sck360/salesDMR/inactivePage|sck360/salesDMR|sck360/salesDMR/settingsPage|sck360/salesKPI|sck360/salesIndividual|sck360/activityPage|sck360/pipelinePage|sck360/dailyActivity/dailyActivityPage|sck360/dailyActivity/dailyActivityPermission|sck360/dailyActivity/workingCalendarPage|sck360/gant/approvals|sck360/gant/meetings|sck360/gant/tracker|sck360/gant/settings|sck360/salesDMR/dashboardPage|sck360/salesDMR/pipelinePage)/?$ /index.html [L]
